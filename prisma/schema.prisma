// ⚠️ Adaptação Task 3 (controller ruling): Prisma 7.10.0 exige `provider = "prisma-client"`
// com `output` explícito (não existe mais `prisma-client-js`), e a URL de conexão não é mais
// permitida no bloco `datasource` — ela vive em `prisma.config.ts` (ver `env('DATABASE_URL')`)
// e é passada via driver adapter (`@prisma/adapter-pg`) ao construtor de `PrismaClient` em
// `src/prisma/prisma.service.ts`. Todo o restante deste arquivo é cópia integral de
// `docs/nestjs-migration/04-schema-prisma-e-dados.md` §1 (repo do front).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
// Valores idênticos aos literais usados hoje (constants/registerTypes.ts) para manter
// `registerType`/`postType` iguais nas respostas da API.
enum UserRole {
  abrigo
  voluntario
  gerente
  admin
}

enum UserOrigin {
  wordpress_migrated
  supabase_native
  admin_created
}

enum ShelterVolunteerStatus {
  pending
  approved
  rejected
}

// ---------- Identidade ----------
// Ex-`profiles` + campos que viviam em auth.users / user_metadata.
model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique // sempre lowercase; ver índice funcional na migração
  passwordHash     String?    @map("password_hash") // bcrypt $2a$10$... ; NULL = sem senha utilizável
  emailVerified    Boolean    @default(false) @map("email_verified")
  fullName         String?    @map("full_name")
  phone            String?
  role             UserRole?
  wpUserId         Int?       @unique @map("wp_user_id")
  origin           UserOrigin @default(supabase_native)
  isTeamOnly       Boolean    @default(false) @map("is_team_only")
  teamDisabled     Boolean    @default(false) @map("team_disabled")
  creatorProfileId String?    @map("creator_profile_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator        User?            @relation("TeamCreator", fields: [creatorProfileId], references: [id], onDelete: SetNull)
  teamMembers    User[]           @relation("TeamCreator")
  shelters       Shelter[]
  volunteers     Volunteer[]
  shelterHistory ShelterHistory[] @relation("HistoryProfile")
  historyChanges ShelterHistory[] @relation("HistoryChangedBy")

  @@index([role])
  @@index([creatorProfileId])
  @@index([origin]) // idx_profiles_origin em produção
  @@map("users")
}

// ---------- Domínio ----------
model Shelter {
  id                 String    @id @default(uuid()) @db.Uuid
  wpPostId           Int?      @unique @map("wp_post_id")
  wpPostAuthor       Int?      @map("wp_post_author") // vínculo legado abrigo↔autor WP (304/337 preenchidas)
  profileId          String?   @map("profile_id") @db.Uuid
  shelterType        String?   @map("shelter_type") // public | private | mixed | temporary; produção é nullable
  cnpj               String?
  cpf                String?
  name               String
  cep                String? // produção é nullable; 228/337 nulas (mesmo padrão de district)
  street             String? // produção é nullable
  number             Int? // produção é integer; 230/337 nulas
  district           String? // produção é nullable; 228/337 nulas
  state              String? // produção é nullable
  city               String? // produção é nullable
  website            String?
  foundationDate     DateTime? @map("foundation_date") @db.Date // produção é date, anulável (4 linhas nulas)
  species            String? // produção é nullable
  additionalSpecies  Json?     @map("additional_species") // 245/337 nulas; forma inconsistente (array ou string) em produção — normalização é decisão da camada de aplicação
  temporaryAgreement Boolean?  @map("temporary_agreement") // ⚠️ confirmar (código aceita string)
  referralSource     String?   @map("referral_source")
  initialDogs        Int?      @map("initial_dogs") // produção é anulável, sem default
  initialCats        Int?      @map("initial_cats") // produção é anulável, sem default
  initialDogsLt      Int?      @map("initial_dogs_lt")
  initialCatsLt      Int?      @map("initial_cats_lt")
  authorizedName     String?   @map("authorized_name") // produção é nullable
  authorizedRole     String?   @map("authorized_role") // produção é nullable
  authorizedEmail    String?   @map("authorized_email") // produção é nullable
  authorizedPhone    String?   @map("authorized_phone") // produção é nullable
  active             Boolean   @default(true)
  acceptTerms        Boolean   @default(false) @map("accept_terms")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  profile           User?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  dynamics          ShelterDynamics[]
  vacancies         Vacancy[]
  history           ShelterHistory[]
  shelterVolunteers ShelterVolunteer[]

  @@unique([profileId]) // upsert onConflict profile_id (api/shelter-profile)
  @@index([state, city])
  @@index([active])
  @@index([species])
  @@index([wpPostAuthor])
  @@map("shelters")
}

model Volunteer {
  id              String   @id @default(uuid()) @db.Uuid
  wpPostId        Int?     @unique @map("wp_post_id")
  ownerProfileId  String?  @map("owner_profile_id") @db.Uuid
  name            String
  slug            String?  @unique
  telefone        String?
  cidade          String?
  estado          String?
  profissao       String?
  escolaridade    String?
  faixaEtaria     String?  @map("faixa_etaria")
  genero          String?
  experiencia     String?
  atuacao         String?
  disponibilidade String?
  periodo         String?
  descricao       String?
  comentarios     String?
  referralSource  String?  @map("referral_source")
  isPublic        Boolean  @default(false) @map("is_public")
  acceptTerms     Boolean  @default(true) @map("accept_terms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  owner        User?                @relation(fields: [ownerProfileId], references: [id], onDelete: SetNull)
  applications VacancyApplication[]
  shelterLinks ShelterVolunteer[]

  @@index([ownerProfileId])
  @@index([estado, cidade])
  @@index([isPublic])
  @@map("volunteers")
}

model Vacancy {
  id                   String   @id @default(uuid()) @db.Uuid
  wpPostId             Int?     @unique @map("wp_post_id")
  shelterId            String?  @map("shelter_id") @db.Uuid
  shelterNameRaw       String?  @map("shelter_name_raw")
  title                String
  slug                 String?  @unique
  description          String?
  status               String?  @default("active") // active | inactive | closed; produção é nullable
  periodo              String?
  cargaHoraria         String?  @map("carga_horaria")
  cidade               String?
  estado               String?
  tipoDemanda          String?  @map("tipo_demanda")
  areaAtuacao          String?  @map("area_atuacao")
  quantidade           String?
  inscritos            Int?
  isPublished          Boolean? @map("is_published")
  habilidadesEFuncoes  String?  @map("habilidades_e_funcoes")
  perfilDosVoluntarios String?  @map("perfil_dos_voluntarios")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  shelter      Shelter?             @relation(fields: [shelterId], references: [id], onDelete: SetNull)
  applications VacancyApplication[]

  @@index([shelterId])
  @@index([status])
  @@index([status, isPublished])
  @@map("vacancies")
}

model VacancyApplication {
  id          String   @id @default(uuid()) @db.Uuid
  vacancyId   String   @map("vacancy_id") @db.Uuid
  volunteerId String   @map("volunteer_id") @db.Uuid
  status      String   @default("pending") // pending | accepted | rejected | withdrawn
  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vacancy   Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, volunteerId]) // erro 23505 → 409 "Você já se candidatou a esta vaga"
  @@index([vacancyId, appliedAt(sort: Desc)])
  @@map("vacancy_applications")
}

model ShelterDynamics {
  id                  String    @id @default(uuid()) @db.Uuid
  shelterId           String    @map("shelter_id") @db.Uuid
  wpPostId            Int?      @map("wp_post_id")
  kind                String // abrigo | lar
  referenceDate       DateTime? @map("reference_date") @db.Date // produção é nullable
  referencePeriod     String?   @map("reference_period") // "YYYY-MM"
  dynamicType         String    @default("dinamica") @map("dynamic_type") // dinamica | dinamica_lar
  entradasDeAnimais   Int?      @default(0) @map("entradas_de_animais")
  entradasDeGatos     Int?      @default(0) @map("entradas_de_gatos")
  adocoesCaes         Int?      @default(0) @map("adocoes_caes")
  adocoesGatos        Int?      @default(0) @map("adocoes_gatos")
  devolucoesCaes      Int?      @default(0) @map("devolucoes_caes")
  devolucoesGatos     Int?      @default(0) @map("devolucoes_gatos")
  eutanasiasCaes      Int?      @default(0) @map("eutanasias_caes")
  eutanasiasGatos     Int?      @default(0) @map("eutanasias_gatos")
  mortesNaturaisCaes  Int?      @default(0) @map("mortes_naturais_caes")
  mortesNaturaisGatos Int?      @default(0) @map("mortes_naturais_gatos")
  doencasCaes         Int?      @default(0) @map("doencas_caes")
  doencasGatos        Int?      @default(0) @map("doencas_gatos")
  retornoDeCaes       Int?      @default(0) @map("retorno_de_caes")
  retornoDeGatos      Int?      @default(0) @map("retorno_de_gatos")
  retornoLocalCaes    Int?      @default(0) @map("retorno_local_caes")
  retornoLocalGatos   Int?      @default(0) @map("retorno_local_gatos")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  @@unique([shelterId, dynamicType, referencePeriod], map: "shelter_dynamics_unique_ref") // upsert onConflict
  @@index([shelterId])
  @@map("shelter_dynamics")
}

// Existe no DDL, sem uso no código. Mantida para não perder dados.
// PK composta (shelter_id, volunteer_id) — forma real de produção; ver enum
// ShelterVolunteerStatus e o gatilho de updated_at (acrescentado à mão na migração).
model ShelterVolunteer {
  shelterId   String                  @map("shelter_id") @db.Uuid
  volunteerId String                  @map("volunteer_id") @db.Uuid
  role        String?
  status      ShelterVolunteerStatus? // produção é nullable, sem default enforçado
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  shelter   Shelter   @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@id([shelterId, volunteerId])
  @@index([volunteerId]) // idx_shelter_volunteers_volunteer em produção
  @@map("shelter_volunteers")
}

// Populada SOMENTE pelo trigger log_shelter_changes() (ver §2). Prisma nunca insere aqui.
model ShelterHistory {
  id            String   @id @default(uuid()) @db.Uuid
  shelterId     String   @map("shelter_id") @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  operation     String // INSERT | UPDATE | DELETE | STATUS_CHANGE (CHECK na migração)
  oldData       Json?    @map("old_data")
  newData       Json?    @map("new_data")
  changedFields String[] @map("changed_fields")
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz
  changedBy     String?  @map("changed_by") @db.Uuid

  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  profile User    @relation("HistoryProfile", fields: [profileId], references: [id], onDelete: Cascade)
  changer User?   @relation("HistoryChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([shelterId])
  @@index([profileId])
  @@index([changedAt(sort: Desc)])
  @@map("shelter_history")
}

// Vínculos gerente/equipe ↔ abrigo. Colunas legadas por wp_user_id / wp_post_id (o código atual só usa essas).
model TeamMembership {
  id              String    @id @default(uuid()) @db.Uuid
  ownerProfileId  String?   @map("owner_profile_id") @db.Uuid
  ownerWpUserId   BigInt?   @map("owner_wp_user_id") // produção é bigint
  memberProfileId String?   @map("member_profile_id") @db.Uuid
  memberWpUserId  BigInt?   @map("member_wp_user_id") // produção é bigint
  memberEmail     String?   @map("member_email")
  abrigoPostId    BigInt?   @map("abrigo_post_id") // produção é bigint
  role            String?   @default("member") // owner | manager | member — CHECK na migração; produção é nullable
  status          String    @default("pending_member") // pending_owner | pending_member | active — CHECK na migração
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([ownerWpUserId, memberWpUserId, abrigoPostId]) // onConflict do script de migração ⚠️ confirmar
  @@unique([ownerWpUserId, memberWpUserId], map: "team_memberships_owner_member_uniq") // unique mais estrito, existe em produção
  @@index([memberWpUserId, role, status])
  @@index([abrigoPostId])
  @@map("team_memberships")
}

// ---------- Legado WordPress (somente leitura pela API) ----------
model WpUserLegacy {
  id          BigInt    @id
  userLogin   String    @map("user_login") @db.VarChar(60) // sem unique em produção
  userEmail   String    @map("user_email") @db.VarChar(100) // sem unique em produção; índice funcional lower(user_email) na migração
  userPass    String    @map("user_pass") @db.VarChar(255)
  displayName String?   @map("display_name") @db.VarChar(250)
  migrated    Boolean?  @default(false)
  migratedAt  DateTime? @map("migrated_at") @db.Timestamptz
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz

  @@map("wp_users_legacy")
}

model WpUserRaw {
  id                BigInt    @id @default(autoincrement())
  userLogin         String    @map("user_login") @db.VarChar(60)
  userPass          String    @map("user_pass") @db.VarChar(255)
  userNicename      String    @map("user_nicename") @db.VarChar(50)
  userEmail         String    @map("user_email") @db.VarChar(100)
  userUrl           String?   @map("user_url") @db.VarChar(100)
  userRegistered    DateTime? @map("user_registered") @db.Timestamp
  userActivationKey String?   @map("user_activation_key") @db.VarChar(255)
  userStatus        Int?      @default(0) @map("user_status")
  displayName       String?   @map("display_name") @db.VarChar(250)

  @@map("wp_users_raw")
}

model WpPostRaw {
  id                  BigInt    @id @default(autoincrement())
  postAuthor          BigInt?   @map("post_author")
  postDate            DateTime? @map("post_date") @db.Timestamp
  postDateGmt         DateTime? @map("post_date_gmt") @db.Timestamp
  postContent         String?   @map("post_content")
  postTitle           String?   @map("post_title")
  postExcerpt         String?   @map("post_excerpt")
  postStatus          String?   @map("post_status") @db.VarChar(20)
  commentStatus       String?   @map("comment_status") @db.VarChar(20)
  pingStatus          String?   @map("ping_status") @db.VarChar(20)
  postPassword        String?   @map("post_password") @db.VarChar(255)
  postName            String?   @map("post_name") @db.VarChar(200)
  toPing              String?   @map("to_ping")
  pinged              String?
  postModified        DateTime? @map("post_modified") @db.Timestamp
  postModifiedGmt     DateTime? @map("post_modified_gmt") @db.Timestamp
  postContentFiltered String?   @map("post_content_filtered")
  postParent          BigInt?   @map("post_parent")
  guid                String?   @db.VarChar(255)
  menuOrder           Int?      @map("menu_order")
  postType            String?   @map("post_type") @db.VarChar(20)
  postMimeType        String?   @map("post_mime_type") @db.VarChar(100)
  commentCount        BigInt?   @map("comment_count")

  @@index([postType])
  @@index([postStatus])
  @@index([postAuthor])
  @@index([postType, postStatus])
  @@map("wp_posts_raw")
}

model WpPostmetaRaw {
  metaId    BigInt  @id @default(autoincrement()) @map("meta_id")
  postId    BigInt  @map("post_id")
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value")

  @@index([postId])
  @@index([metaKey])
  @@index([postId, metaKey])
  @@map("wp_postmeta_raw")
}

model WpUsermetaRaw {
  umetaId   BigInt  @id @default(autoincrement()) @map("umeta_id")
  userId    BigInt  @map("user_id")
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value")

  @@index([userId])
  @@index([metaKey])
  @@index([userId, metaKey])
  @@map("wp_usermeta_raw")
}

// Fila de exclusão suave (soft-delete). Populada/lida pelo fluxo administrativo; 4 linhas hoje.
model DeletionFlag {
  id        String    @id @default(uuid()) @db.Uuid
  tableName String    @map("table_name") @db.VarChar
  recordId  String    @map("record_id")
  flaggedAt DateTime? @map("flagged_at") @db.Timestamptz
  flaggedBy String?   @map("flagged_by") @db.VarChar
  reason    String?
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  status    String    @default("pending") @map("status") @db.VarChar // pending | deleted — CHECK na migração

  @@index([status, tableName], map: "idx_deletion_flags_status") // compound em produção; unique parcial (table_name, record_id) WHERE status='pending' acrescentado à mão na migração
  @@map("deletion_flags")
}
