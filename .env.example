NODE_ENV=development
PORT=3001
# Host ports 5433/6380 (not 5432/6379): this machine already runs another project's
# Postgres/Redis on the default ports. Inside docker-compose.yml the services still use
# 5432/6379 on the internal network — only the host-side mapping differs.
DATABASE_URL=postgresql://mv:mv@localhost:5433/mvabrigos?schema=public
REDIS_URL=redis://:mv@localhost:6380/0
AUTH_JWT_SECRET=change-me-run-openssl-rand-hex-64-and-paste-result-here
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
COOKIE_SECURE=false
APP_URL=http://localhost:3000
# Segredo compartilhado com o Next (mesmo valor nos dois) que isenta o SSR do
# rate limit. Gerar com: openssl rand -hex 32
INTERNAL_API_TOKEN=
BCRYPT_COST=10
# Sem RESEND_API_KEY a API não envia e-mail: em dev só loga os links.
RESEND_API_KEY=
# Segredo de assinatura do webhook do Resend; sem ele o endpoint responde 404.
RESEND_WEBHOOK_SECRET=
MAIL_FROM=MV Abrigos <no-reply@mail.mvabrigosbrasil.com.br>
# Teto diário de e-mails deste ambiente (padrão 100 = plano free inteiro). Com
# dev e produção na mesma conta, divida: ex. produção 80 e dev 20.
MAIL_DAILY_LIMIT=
