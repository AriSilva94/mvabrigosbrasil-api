NODE_ENV=development
PORT=3001
# Host ports 5433/6380 (not 5432/6379): this machine already runs another project's
# Postgres/Redis on the default ports. Inside docker-compose.yml the services still use
# 5432/6379 on the internal network — only the host-side mapping differs.
DATABASE_URL=postgresql://mv:mv@localhost:5433/mvabrigos?schema=public
REDIS_URL=redis://:mv@localhost:6380/0
AUTH_JWT_SECRET=change-me-run-openssl-rand-hex-64-and-paste-result-here
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
COOKIE_SECURE=false
APP_URL=http://localhost:3000
BCRYPT_COST=10
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MV Abrigos <contato@mvabrigosbrasil.com.br>
